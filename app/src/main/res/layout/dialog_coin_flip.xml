<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/dialog_coin_flip.xml
    ────────────────────────────────────────────────────
    Coin Flip Dialog for "Plan and Eat"
    • Lets the user set two custom choice labels (default: Heads / Tails)
    • Shows an animated coin image that flips between heads/tails states
    • Displays the result after the flip animation completes
    ────────────────────────────────────────────────────
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1A1A1A">

    <!-- ── Title ─────────────────────────────────── -->
    <TextView
        android:id="@+id/tvCoinFlipTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="🪙 Coin Flip"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Can't decide? Let fate choose!"
        android:textColor="#808080"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="20dp" />

    <!-- ── Custom Choice Labels ──────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <!-- Heads label input -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEADS"
                android:textColor="#FFC107"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHeads"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#FFC107"
                app:boxBackgroundColor="#252525"
                app:hintTextColor="#808080"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHeadsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Chicken"
                    android:text="Heads"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#505050"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- VS divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="VS"
            android:textColor="#505050"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1" />

        <!-- Tails label input -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAILS"
                android:textColor="#FFC107"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTails"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="#FFC107"
                app:boxBackgroundColor="#252525"
                app:hintTextColor="#808080"
                app:boxStrokeWidth="1dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTailsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Rice"
                    android:text="Tails"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#505050"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Coin image (animated during flip) ──────── -->
    <!--
        Uses two image slots that alternate rapidly to simulate a flip.
        Both reference vector drawables you define (see note below).
        ivCoinActive shows during animation; ivCoinResult shows the final side.
    -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <!-- Heads face (yellow coin) -->
        <ImageView
            android:id="@+id/ivCoinHeads"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_coin_heads"
            android:contentDescription="Heads"
            android:scaleType="fitCenter"
            android:visibility="visible" />

        <!-- Tails face (dark coin) -->
        <ImageView
            android:id="@+id/ivCoinTails"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_coin_tails"
            android:contentDescription="Tails"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ── Result text ───────────────────────────── -->
    <TextView
        android:id="@+id/tvCoinResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Tap the coin to flip!"
        android:textColor="#808080"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- ── Flip button ────────────────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFlipCoin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🪙  FLIP THE COIN"
        android:textColor="#0D0D0D"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        app:backgroundTint="#FFC107"
        app:cornerRadius="12dp"
        app:rippleColor="#FFCA28"
        android:layout_marginBottom="8dp" />

    <!-- ── Close button ───────────────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCoinFlipClose"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Close"
        android:textColor="#808080"
        android:textSize="14sp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp" />

</LinearLayout>