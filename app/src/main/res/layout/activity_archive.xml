<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_archive.xml
    Place in:  app/src/main/res/layout/activity_archive.xml
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar / header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnArchiveBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_archive"
            app:tint="?attr/colorOnSurface"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Meal Archive"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline"
        android:alpha="0.3" />

    <!-- Empty state — shown when no archive entries exist -->
    <TextView
        android:id="@+id/tvArchiveEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="No meal plans archived yet.\nStart logging meals to see your history here."
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

    <!-- Archive list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerArchive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp" />

</LinearLayout>
