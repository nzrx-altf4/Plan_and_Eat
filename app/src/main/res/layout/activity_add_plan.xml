<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/activity_add_plan.xml
    "Plan and Eat" — Add / Create Meal Plan Screen
    ═══════════════════════════════════════════════════════════════
    ALL RESOURCE-LINKING ERRORS FIXED:

    FIX 1 — boxStrokeColorStateList (×3 occurrences)
      REMOVED:  app:boxStrokeColorStateList="@color/til_stroke_selector"
      REASON:   Requires Material 1.5.0+; causes link failure on older versions
      REPLACED: app:boxStrokeColor="#FFC107" (focused amber, works on all versions)

    FIX 2 — counterTextColor incompatible hex (tilMealName)
      REMOVED:  app:counterTextColor="#505050"
      REPLACED: app:counterTextColor="@color/counter_normal"
      ACTION:   Add <color name="counter_normal">#505050</color> to colors.xml

    FIX 3 — counterOverflowTextColor incompatible hex (tilMealName)
      REMOVED:  app:counterOverflowTextColor="#CF6679"
      REPLACED: app:counterOverflowTextColor="@color/counter_overflow"
      ACTION:   Add <color name="counter_overflow">#CF6679</color> to colors.xml

    FIX 4 — android:buttonCompat not found (cbIsHomemade)
      REMOVED:  android:button="@null"
      REMOVED:  android:buttonCompat="@null"         ← wrong namespace
      REMOVED:  app:buttonCompat="@drawable/cb_homemade_selector"  ← file doesn't exist
      KEPT:     app:buttonTint="#FFC107"              ← sufficient for amber tint
    ═══════════════════════════════════════════════════════════════
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp"
        tools:context=".AddPlanActivity">

        <!-- ═══════════════════════════════════════════════════
             HEADER SECTION
             ═══════════════════════════════════════════════════ -->

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_previous"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#808080" />

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="Create Meal Plan"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvScreenSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif"
            android:text="Fill in the details for your meal entry."
            android:textColor="#505050"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvScreenTitle" />

        <View
            android:id="@+id/viewHeaderAccent"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            android:background="#FFC107"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvScreenSubtitle" />

        <!-- ═══════════════════════════════════════════════════
             FORM CARD
             ═══════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewHeaderAccent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- ── MEAL CATEGORY ──────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:text="MEAL CATEGORY"
                    android:textColor="#FFC107"
                    android:textSize="10sp" />

                <!--
                    FIX 1 APPLIED: removed app:boxStrokeColorStateList
                    REPLACED WITH: app:boxStrokeColor="#FFC107"
                -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPlanTitle"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select category"
                    app:boxBackgroundColor="#222222"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#FFC107"
                    app:hintTextColor="#808080"
                    app:startIconDrawable="@android:drawable/ic_menu_today"
                    app:startIconTint="#505050">

                    <AutoCompleteTextView
                        android:id="@+id/etPlanTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:fontFamily="sans-serif"
                        android:inputType="none"
                        android:paddingStart="4dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#505050"
                        android:textSize="15sp"
                        tools:text="Breakfast" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <!-- ── MEAL NAME ───────────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:text="MEAL NAME"
                    android:textColor="#FFC107"
                    android:textSize="10sp" />

                <!--
                    FIX 1 APPLIED: removed app:boxStrokeColorStateList
                    FIX 2 APPLIED: counterTextColor now uses @color/counter_normal
                    FIX 3 APPLIED: counterOverflowTextColor now uses @color/counter_overflow
                    (Add both to res/values/colors.xml — see note at bottom of file)
                -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMealName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Silog Meal, Chicken Adobo…"
                    app:boxBackgroundColor="#222222"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#FFC107"
                    app:counterEnabled="true"
                    app:counterMaxLength="60"
                    app:counterTextColor="@color/counter_normal"
                    app:counterOverflowTextColor="@color/counter_overflow"
                    app:hintTextColor="#808080"
                    app:startIconDrawable="@android:drawable/ic_menu_edit"
                    app:startIconTint="#505050">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMealName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#505050"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <!-- ── COST / PRICE ────────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:text="COST / PRICE"
                    android:textColor="#FFC107"
                    android:textSize="10sp" />

                <!--
                    FIX 1 APPLIED: removed app:boxStrokeColorStateList
                    REPLACED WITH: app:boxStrokeColor="#FFC107"
                -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMealCost"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0.00"
                    app:boxBackgroundColor="#222222"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#FFC107"
                    app:hintTextColor="#808080"
                    app:prefixText="₱ "
                    app:prefixTextColor="#FFC107"
                    app:suffixText="PHP"
                    app:suffixTextColor="#383838">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMealCost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#505050"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Enter the total cost of this meal."
                    android:textColor="#404040"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#252525" />

                <!-- ── MEAL TYPE CHECKBOX ──────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:text="MEAL TYPE"
                    android:textColor="#FFC107"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_checkbox_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <!--
                        FIX 4 APPLIED:
                          REMOVED android:button="@null"
                          REMOVED android:buttonCompat="@null"     ← invalid namespace
                          REMOVED app:buttonCompat="@drawable/cb_homemade_selector"  ← file missing
                          KEPT    app:buttonTint="#FFC107"          ← tints default checkbox amber
                    -->
                    <CheckBox
                        android:id="@+id/cbIsHomemade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:contentDescription="Mark meal as homemade"
                        app:buttonTint="#FFC107" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Homemade Meal"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="Cooked at home, not purchased"
                            android:textColor="#505050"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHomemadeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_amber"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="🏠 Home"
                        android:textColor="#0D0D0D"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════
             BUTTONS
             ═══════════════════════════════════════════════════ -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePlan"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="Save Plan"
            android:textColor="#0D0D0D"
            android:textSize="15sp"
            app:backgroundTint="#FFC107"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#0D0D0D"
            app:rippleColor="#FFCA28"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardForm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPlan"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="sans-serif"
            android:text="Cancel"
            android:textColor="#606060"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:rippleColor="#1AFFFFFF"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSavePlan" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

    <!--
        ════════════════════════════════════════════════════════════════════════
        ONE REQUIRED CHANGE IN res/values/colors.xml
        ════════════════════════════════════════════════════════════════════════
        Add these two lines inside your existing <resources> block:

            <color name="counter_normal">#505050</color>
            <color name="counter_overflow">#CF6679</color>

        These are referenced by app:counterTextColor and app:counterOverflowTextColor
        on tilMealName. Those attributes only accept @color references, not raw hex.
        ════════════════════════════════════════════════════════════════════════

        COMPANION DRAWABLE FILES (create if not already done):
        ════════════════════════════════════════════════════════════════════════

        ① res/drawable/bg_checkbox_row.xml
        <?xml version="1.0" encoding="utf-8"?>
        <shape xmlns:android="http://schemas.android.com/apk/res/android">
            <solid android:color="#222222" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#2A2A2A" />
        </shape>

        ② res/drawable/bg_badge_amber.xml
        <?xml version="1.0" encoding="utf-8"?>
        <shape xmlns:android="http://schemas.android.com/apk/res/android">
            <solid android:color="#FFC107" />
            <corners android:radius="20dp" />
        </shape>

        ③ res/layout/list_item_dropdown.xml
        <?xml version="1.0" encoding="utf-8"?>
        <TextView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="#1A1A1A"
            android:fontFamily="sans-serif" />
        ════════════════════════════════════════════════════════════════════════
    -->